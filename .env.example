# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.

# --- Payment provider switch ---
# "stripe" (default, leave unset) means you are the merchant of record and
# handle VAT/sales tax collection and filing yourself. "lemonsqueezy" uses
# Lemon Squeezy as merchant of record instead — they collect and remit VAT
# for you, which lets you sell before you've registered for VAT yourself.
# See src/lib/payments.ts.
PAYMENT_PROVIDER=stripe

# --- Stripe (server-side only, never exposed to the browser) ---
# Paste your secret key from https://dashboard.stripe.com/apikeys
# (starts with "sk_test_" in test mode, "sk_live_" in live mode)
STRIPE_SECRET_KEY=

# The Stripe Price IDs for each tier (one-time prices, start with "price_")
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_PREMIUM=
# DG Training Academy sold on its own, and the "everything" bundle
# (Toolkit Premium + DG Training Academy). See src/config/site.ts for
# the prices shown on the pricing page — keep these Stripe Prices in sync.
STRIPE_PRICE_ID_DG=
STRIPE_PRICE_ID_BUNDLE=

# Where Stripe redirects after a successful / cancelled checkout
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL: if you prefer no-code Stripe Payment Links instead of the API
# route, paste them here and the matching buttons will link to them
# directly. Leave both empty to use the built-in /api/checkout route.
# If you do use Payment Links, set each one's "After payment" redirect (in
# the Stripe Dashboard) to:
#   {your domain}/download?session_id={CHECKOUT_SESSION_ID}
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_STANDARD=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PREMIUM=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_DG=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_BUNDLE=

# --- Lemon Squeezy (only used when PAYMENT_PROVIDER=lemonsqueezy) ---
# From https://app.lemonsqueezy.com/settings/api — needs "read" + "write".
LEMONSQUEEZY_API_KEY=
# Settings -> Stores in your Lemon Squeezy dashboard.
LEMONSQUEEZY_STORE_ID=
# Create one product with one variant per tier, then paste each variant's
# ID here (visible in the product's URL / API response).
LEMONSQUEEZY_VARIANT_ID_STANDARD=
LEMONSQUEEZY_VARIANT_ID_PREMIUM=
LEMONSQUEEZY_VARIANT_ID_DG=
LEMONSQUEEZY_VARIANT_ID_BUNDLE=

# --- Lead capture (server-side only) ---
# Webhook URL for the free "Emergency Vessel Shipment Checklist" email
# opt-in in the Bonus section. Works with any tool that accepts an
# incoming webhook: Zapier, Make, Mailchimp, ConvertKit, Beehiiv, a Google
# Sheets webhook, etc. Leave empty during development — the checklist
# still downloads, the email just isn't captured anywhere yet.
LEAD_WEBHOOK_URL=

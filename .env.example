# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.

# --- Stripe (server-side only, never exposed to the browser) ---
# Paste your secret key from https://dashboard.stripe.com/apikeys
# (starts with "sk_test_" in test mode, "sk_live_" in live mode)
STRIPE_SECRET_KEY=

# The Stripe Price ID for the Marine Logistics Operator Toolkit (one-time price)
# (starts with "price_")
STRIPE_PRICE_ID=

# Where Stripe redirects after a successful / cancelled checkout
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL: if you prefer a no-code Stripe Payment Link instead of the API route,
# paste it here and the "Get Toolkit" buttons will link to it directly.
# Leave empty to use the built-in /api/checkout route instead.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
